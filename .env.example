# Backend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# asyncpg DSN for the backend's DIRECT Postgres access (CLAUDE.md §3). Use the
# Supabase "Connection pooler" string (IPv4-friendly), NOT the direct 5432 one:
#   Dashboard -> Project Settings -> Database -> Connection string -> Connection pooler
# Set this and the backend uses Supabase; leave it blank and it uses the mock.
DATABASE_URL=
ANTHROPIC_API_KEY=
# No TWILIO_* / RETELL_* here on purpose: this backend never dials out. Messaging and
# Voice hold those credentials inside their own services (listed at the bottom).

# --- Channel-service seams (both legs must be set for the loop to close) -----
# OUTBOUND: us -> their service. Leave blank and the caller degrades gracefully —
# make_phone_call records a visibly stubbed attempt (placed=false, stub=true) so the
# offline demo still closes the loop; the ranking proxy routes error instead.
CALL_AGENT_BASE_URL=            # -> backend/call_agent/     (/place-referral-call)
SERVICE_RANKING_BASE_URL=       # -> backend/service_ranking/ (/rank-referral, /sw-feedback)
#
# INBOUND: their service -> our adapters (backend/adapters/inbound.py). These are read
# by THEIR processes, not ours — set them in the environment each service runs in.
# Both are best-effort on their side: unset means they skip the forward silently, so
# the referral never leaves `submitted` and the loop looks stalled with no error.
ORCHESTRATOR_BASE_URL=          # read by call_agent    -> POST /api/voice/call-outcome
ORG_BACKEND_URL=                # read by patient_comms -> POST /api/patient-comms/event

# --- Deploy ---------------------------------------------------------------------
# Origins allowed to call this backend (comma-separated). Local dev defaults to the
# Vite server; a deployed frontend MUST be listed here or every call fails CORS.
ALLOWED_ORIGINS=http://localhost:5173

# Frontend (frontend/.env — Vite only exposes VITE_*-prefixed vars, and inlines them
# at BUILD time, so this must be set wherever the bundle is built, not at runtime).
VITE_API_BASE=http://localhost:8000

# Every service now uses the SAME name for the same thing, so one value can be pasted
# across all four deploys. Each still reads its own env — set these in that service's
# deploy environment, not here:
#   backend/call_agent/      SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RETELL_API_KEY,
#                            RETELL_FROM_NUMBER, RETELL_TRANSPORTATION_AGENT_ID,
#                            ORCHESTRATOR_BASE_URL
#   backend/service_ranking/ SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY
#   backend/patient_comms/   DATABASE_URL, SMS_PROVIDER, TWILIO_ACCOUNT_SID,
#                            TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER, ORG_BACKEND_URL
#
# Remaining known mismatch (Messaging owns Twilio, so theirs is canonical): they send
# from TWILIO_FROM_NUMBER / WHATSAPP_FROM. We hold no Twilio or Retell credential —
# notify_patient is a local stub and all dialing happens inside their services — so
# those keys are listed above rather than here.
SUPABASE_ANON_KEY=
