# Backend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# asyncpg DSN for the backend's DIRECT Postgres access (CLAUDE.md §3). Use the
# Supabase "Connection pooler" string (IPv4-friendly), NOT the direct 5432 one:
#   Dashboard -> Project Settings -> Database -> Connection string -> Connection pooler
# Set this and the backend uses Supabase; leave it blank and it uses the mock.
DATABASE_URL=
ANTHROPIC_API_KEY=
# No TWILIO_* / RETELL_* here on purpose: this backend never dials out. Messaging and
# Voice hold those credentials inside their own services (listed at the bottom).

# --- Channel-service seams (both legs must be set for the loop to close) -----
# OUTBOUND: us -> their service. Leave blank and the caller degrades gracefully —
# make_phone_call records a visibly stubbed attempt (placed=false, stub=true) so the
# offline demo still closes the loop; the ranking proxy routes error instead.
CALL_AGENT_BASE_URL=            # -> backend/call_agent/     (/place-referral-call)
SERVICE_RANKING_BASE_URL=       # -> backend/service_ranking/ (/rank-referral, /sw-feedback)
#
# INBOUND: their service -> our adapters (backend/adapters/inbound.py). These are read
# by THEIR processes, not ours — set them in the environment each service runs in.
# Both are best-effort on their side: unset means they skip the forward silently, so
# the referral never leaves `submitted` and the loop looks stalled with no error.
ORCHESTRATOR_BASE_URL=          # read by call_agent    -> POST /api/voice/call-outcome
ORG_BACKEND_URL=                # read by patient_comms -> POST /api/patient-comms/event

# --- The action-queue worker (backend/orchestrator/worker.py) -------------------
# We poll `referral_actions` for two components: `karthik_form` and `backend`.
# Defaults are chosen so a plain deploy is a WORKING worker; you only set these to
# turn something off or to change the cadence.
WORKER_ENABLED=1                # 0 disables the background poller entirely
WORKER_POLL_SECONDS=5           # tick interval when the queue is empty
WORKER_STALE_AFTER_SECONDS=120  # an `in_progress` action older than this is reclaimed
#
# A3 — also call advance_referral() for every open referral each tick. Off by default
# because it's one of two valid designs (the other being "every component advances
# itself after finishing"), and the team hasn't picked. Turn this on if Voice and
# Messaging are NOT calling advance_referral, or their chains stop dead after each step.
ORCHESTRATOR_TICK=0
#
# A1/A2 — claim `rank_resources` actions and proxy them to SERVICE_RANKING_BASE_URL.
# Off by default: writing referral_service_candidates is Ranking's job
# (docs/handoff-ranking-candidates.md), and claiming the action without doing the work
# would let the referral advance with an empty shortlist and escalate as "no resource".
BACKEND_CLAIM_RANKING=0
#
# Whether creating a referral may kick advance_referral() on the LIVE DB. Doing so
# queues confirm_consent -> twilio, and Messaging's deployed poller sends a REAL
# WhatsApp to whatever number was typed, billed to the team's Twilio.
#
# OFF by default because this app has NO AUTH: on a public URL, anyone who finds it can
# open "+ New referral" and send messages on your account. Fine to turn on behind a
# short-lived tunnel you're actively testing; leave it off on a permanent deploy until
# you're demoing intake. Rows are still written either way — only the outbound kick is
# withheld, and the API response says so instead of looking like a success.
ALLOW_LIVE_INTAKE=0

# --- Deploy ---------------------------------------------------------------------
# Origins allowed to call this backend (comma-separated). Local dev defaults to the
# Vite server. NOT needed when the frontend is served BY this backend (the default
# for a deployed build — see the StaticFiles mount at the bottom of backend/main.py):
# same-origin requests aren't subject to CORS at all.
ALLOWED_ORIGINS=http://localhost:5173

# Frontend (frontend/.env — Vite only exposes VITE_*-prefixed vars, and inlines them
# at BUILD time, so this must be set wherever the bundle is built, not at runtime).
#
# LEAVE THIS BLANK for a deployed build. A production bundle defaults to same-origin
# relative URLs, which is what lets the public URL change — a new tunnel, a new Railway
# domain — without rebuilding. Only set it if you host the frontend somewhere separate
# from the backend, and then it must be the backend's full origin.
VITE_API_BASE=

# Every service now uses the SAME name for the same thing, so one value can be pasted
# across all four deploys. Each still reads its own env — set these in that service's
# deploy environment, not here:
#   backend/call_agent/      SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RETELL_API_KEY,
#                            RETELL_FROM_NUMBER, RETELL_TRANSPORTATION_AGENT_ID,
#                            ORCHESTRATOR_BASE_URL
#   backend/service_ranking/ SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY
#   backend/patient_comms/   DATABASE_URL, SMS_PROVIDER, TWILIO_ACCOUNT_SID,
#                            TWILIO_AUTH_TOKEN, TWILIO_FROM_NUMBER, ORG_BACKEND_URL
#
# Remaining known mismatch (Messaging owns Twilio, so theirs is canonical): they send
# from TWILIO_FROM_NUMBER / WHATSAPP_FROM. We hold no Twilio or Retell credential —
# notify_patient is a local stub and all dialing happens inside their services — so
# those keys are listed above rather than here.
SUPABASE_ANON_KEY=
