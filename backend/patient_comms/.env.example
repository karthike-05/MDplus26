# Copy to `.env` and fill in. `.env` is git-ignored; never commit real creds.

# ---- SMS mode ----
# mock  = messages render in logs / dashboard only (default, no accounts needed)
# twilio = real texts. Requires the three TWILIO_* values below.
SMS_PROVIDER=mock

# ---- Twilio (only needed when SMS_PROVIDER=twilio) ----
# From the Twilio Console home page:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# An SMS-capable number you've provisioned in Twilio (E.164, e.g. +18885551234):
TWILIO_FROM_NUMBER=
# NOTE: trial accounts can ONLY text verified numbers AND cannot send custom
# message bodies (error 572006) -- upgrade the account (add funds) to send.
#
# Reject inbound webhooks without a valid Twilio signature (turn ON in prod;
# leave OFF for local curl/dashboard testing):
# TWILIO_VALIDATE_SIGNATURE=1
# Behind ngrok/a proxy, set the exact public URL Twilio calls (signature is
# computed over it), else validation fails:
# TWILIO_WEBHOOK_URL=https://<your-id>.ngrok-free.dev/webhook/sms-inbound

# ---- Scheduler timescale ----
# real     = true 3-day / 7-day cadence (production)
# seconds  = compressed for demos; one logical "day" = DEMO_DAY_SECONDS
DEMO_TIMESCALE=seconds
DEMO_DAY_SECONDS=5
# ENABLE_SCHEDULER=0 turns auto-firing off (manual endpoints only)

# ---- Inbound reply classifier ----
# keyword = exact-match keywords (default, offline, no API key)
# llm     = Claude reads the reply and classifies intent (catches "I called but
#           no one answered", "which appointment?", etc). Outbound stays templated.
CLASSIFIER=keyword
# ANTHROPIC_API_KEY=sk-ant-...            # required when CLASSIFIER=llm
# CLASSIFIER_MODEL=claude-haiku-4-5       # cost/speed pick for a classifier;
#                                         # defaults to claude-opus-4-8 if unset
# NOTE: the reply text can contain patient-volunteered PHI -> use a HIPAA/BAA
# Anthropic endpoint before any real patient traffic.

# ---- Database ----
# Defaults to local SQLite. Point at Supabase once Gyan's schema is confirmed:
# DATABASE_URL=postgresql://<supabase-connection-string>

# Conversational responder (patient reply phrasing). Default on; set off for
# byte-identical templated behavior (CI/dev with no API key). Uses the same
# ANTHROPIC_API_KEY as the inbound classifier; run against a BAA endpoint.
RESPONDER=on
RESPONDER_MODEL=claude-haiku-4-5
